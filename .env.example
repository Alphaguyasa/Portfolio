# Contact form delivery (optional).
#
# Without RESEND_API_KEY the /api/contact route returns delivery:"unconfigured"
# and the form falls back to opening the visitor's mail client with the message
# prefilled — it still works, it just isn't server-sent.
#
# To switch on real delivery: create a key at https://resend.com/api-keys and add
# it in the Vercel project's Environment Variables, then redeploy.
RESEND_API_KEY=

# Optional. Defaults to Resend's shared sender (onboarding@resend.dev), which works
# without a verified domain. Override once a domain is verified in Resend.
CONTACT_FROM="Portfolio <hello@yourdomain.com>"
