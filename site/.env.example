# Copy to .env.local and fill in. Never commit .env.local.

# From https://resend.com/api-keys — starts with "re_"
RESEND_API_KEY=

# Optional. Defaults to "Portfolio <onboarding@resend.dev>", Resend's shared
# sender, which can ONLY deliver to the address that owns the Resend account.
# Once you verify a domain at https://resend.com/domains, set this to an
# address on it so mail can go anywhere.
# CONTACT_FROM=Portfolio <hello@yourdomain.com>
